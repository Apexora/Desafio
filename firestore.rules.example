// Añade estas reglas a las que ya tienes en Firestore (no reemplaces las de tus otras páginas).
// Dentro de: match /databases/{database}/documents { ... }

match /apexora_profiles/{uid} {
  allow read: if true;                                   // el Portal lista los perfiles por nombre
  allow create, update: if request.auth != null && request.auth.uid == uid;
}
match /apexora_data/{uid} {
  allow read, write: if request.auth != null && request.auth.uid == uid;   // progreso de los retos: solo el dueño
}
